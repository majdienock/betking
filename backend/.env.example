# ─── Server Configuration ──────────────────────────────────────
NODE_ENV=development
PORT=3000
# Private PIN setup: run npm --prefix backend run setup-pin-owner in your terminal.
# The setup command saves the owner-key hash in MongoDB. Admin PINs are saved
# in MongoDB through Administrators > Private PIN setup.
# Comma-separated browser origins allowed to call the API. An entry may carry
# one wildcard label — "https://*.vercel.app" — which matches a single level of
# subdomain and is how Vercel preview deployments, whose hostname changes with
# every push, reach the API without being listed one by one.
#
# An origin missing from this list fails in the browser only: the request never
# reaches a route, so the site looks like it is hanging rather than reporting an
# error. Add the deployed frontend domains here before wondering why a fresh
# deployment does nothing.
CORS_ORIGIN=http://localhost:4200,https://betking.site,https://www.betking.site

# ─── JWT Authentication Secret ─────────────────────────────────
JWT_SECRET=replace_with_a_long_random_secret

# ─── MongoDB Database ──────────────────────────────────────────
# The database name before the "?" is REQUIRED and the server refuses to start
# without it. Leaving it out does not fail — the driver quietly picks its own
# default ("test"), which is how a deployment can serve an empty database while
# the real accounts sit untouched under another name on the same cluster.
#
# It must name the database that actually holds the data. Pointing at the wrong
# one does not error: an empty database behaves exactly like a working one
# except that every login fails and every registration lands somewhere nobody
# is looking.
MONGODB_URI=mongodb+srv://<username>:<url-encoded-password>@cluster0.abcde.mongodb.net/betking?retryWrites=true&w=majority

# For local MongoDB, use this instead:
# MONGODB_URI=mongodb://127.0.0.1:27017/betking

# ─── PayHero M-Pesa Integration (Optional) ─────────────────────
PAYHERO_BASE_URL=https://backend.payhero.co.ke/api/v2
PAYHERO_API_USERNAME=your_payhero_api_username
PAYHERO_API_PASSWORD=your_payhero_api_password
PAYHERO_CHANNEL_ID=your_payhero_channel_id
PAYHERO_CALLBACK_URL=https://api.betking.site/api/mpesa/callback?token=shared_secret_for_the_callback

# Callback shared secret. Production rejects callbacks when this is unset.
# Put the same value in the callback URL token query parameter.
PAYHERO_CALLBACK_TOKEN=shared_secret_for_the_callback

# Optional: a pre-issued Basic token used instead of the username/password pair.
# PAYHERO_AUTH_TOKEN=

# ─── Existing Superadmin Bootstrap ─────────────────────────────
# A fresh database is bootstrapped using the existing superadmin account.
# Existing databases and superadmin accounts are never reset at startup.
# INITIAL_SUPERADMIN_PASSWORD=

# Optional external M-Pesa synchronization; no endpoint or key is assumed.
# MPESA_API_URL=
# MPESA_CONNECT_KEY=
